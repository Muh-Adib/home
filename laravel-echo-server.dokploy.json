{
    "authHost": "${APP_URL}",
    "authEndpoint": "/broadcasting/auth",
    "clients": [
        {
            "appId": "${PUSHER_APP_ID}",
            "key": "${PUSHER_APP_KEY}"
        }
    ],
    "database": "redis",
    "databaseConfig": {
        "redis": {
            "host": "${REDIS_HOST}",
            "port": "${REDIS_PORT}",
            "password": "${REDIS_PASSWORD}",
            "db": "${REDIS_DB}"
        }
    },
    "devMode": false,
    "host": "0.0.0.0",
    "port": "6001",
    "protocol": "http",
    "socketio": {
        "cors": {
            "origin": "*",
            "methods": ["GET", "POST"]
        }
    },
    "apiOriginAllow": {
        "allowCors": true,
        "allowOrigin": "*",
        "allowMethods": "GET,POST",
        "allowHeaders": "Origin,Content-Type,Accept,Authorization,X-Request-With"
    },
    "referrers": [],
    "subscribers": {
        "http": true,
        "redis": true
    }
}