# Laravel Echo Server Environment Variables
# Copy this file to .env.echo and update values

# Authentication
AUTH_HOST=http://localhost:80
APP_ID=homsjogja
PUSHER_KEY=your-pusher-key

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

# Echo Server Configuration
DEV_MODE=false
ECHO_HOST=127.0.0.1
ECHO_PORT=3000
ECHO_PROTOCOL=http

# SSL Configuration (optional)
SSL_CERT_PATH=
SSL_KEY_PATH=
SSL_CERT_CHAIN_PATH=
SSL_PASSPHRASE= 