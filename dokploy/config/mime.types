    application/graphql                   graphql gql;
    application/wasm                      wasm;
    application/manifest+json             webmanifest;
    application/octet-stream              bin exe dll deb dmg iso img msi msp msm *;

    audio/midi                            mid midi kar;
    audio/mpeg                            mp3;
    audio/ogg                             oga ogg;
    audio/m4a                             m4a;
    audio/wav                             wav;

    video/3gpp                            3gpp 3gp;
