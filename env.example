# Laravel Environment Configuration
# Copy this file to .env and update values

APP_NAME="Property Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (SQLite for Development)
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# MySQL Configuration (for Production)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=property_management
# DB_USERNAME=root
# DB_PASSWORD=

# Broadcasting Configuration (Soketi)
BROADCAST_DRIVER=pusher

# Pusher Configuration (for Soketi)
PUSHER_APP_ID=app-id
PUSHER_APP_KEY=app-key
PUSHER_APP_SECRET=app-secret
PUSHER_HOST=127.0.0.1
PUSHER_PORT=6001
PUSHER_SCHEME=http
PUSHER_APP_CLUSTER=mt1

# Redis Configuration (Optional - for caching and queues)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0

# Queue Configuration
QUEUE_CONNECTION=sync
# QUEUE_CONNECTION=redis (for production)

# Cache Configuration
CACHE_DRIVER=file
# CACHE_DRIVER=redis (for production)

# Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Notification Configuration
NOTIFICATION_CHANNELS=database,broadcast

# Logging Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# File Storage
FILESYSTEM_DISK=local

# Security
SANCTUM_STATEFUL_DOMAINS=localhost:8000
SESSION_DOMAIN=localhost

# Development Tools
DEBUGBAR_ENABLED=true

# iPaymu Payment Gateway Configuration
# VA (Virtual Account) adalah nomor Virtual Account dari iPaymu
# VA juga digunakan sebagai API Key untuk autentikasi
IPAYMU_MODE=sandbox
IPAYMU_VA=
# IPAYMU_API_KEY (backward compatibility - akan menggunakan IPAYMU_VA jika tidak di-set)
IPAYMU_API_KEY=
IPAYMU_CALLBACK_URL=
IPAYMU_RETURN_URL=
IPAYMU_NOTIFY_URL=
IPAYMU_EXPIRY_HOURS=24
IPAYMU_VERIFY_WEBHOOK=true
IPAYMU_LOG_REQUESTS=true
IPAYMU_LOG_CHANNEL=daily




